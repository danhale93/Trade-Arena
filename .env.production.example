# Trade Arena Production Environment Template
# Copy this file to .env.production on your production host and fill in your secrets.
# NEVER commit .env.production or actual secrets to git.

NODE_ENV=production
PORT=3000
MM_PATH=/usr/local/bin/mm
DIRECT_EXECUTION_ENABLED=false

# Database Connection (MySQL / TiDB)
DATABASE_URL=mysql://user:password@host:3306/database

# Session & Authentication Secrets
JWT_SECRET=your_secure_jwt_secret_here

# MetaMask Agent Wallet Token (obtained via mm login browser)
MM_CLI_TOKEN=cliToken:cliRefreshToken

# Managed Wallet Address (must match signed wallet)
MANAGED_WALLET_ADDRESS=0x2ca1f801c1e19d16160c982c627e2932e95117be

# Direct Execution Safety Caps (leave disabled false for simulation mode)
DIRECT_EXECUTION_ENABLED=false
DIRECT_LIVE_CONFIRMATION=I_UNDERSTAND_LIVE_TRADES
DIRECT_MAX_GAS_GWEI=50
DIRECT_MAX_INPUT_AMOUNT=0.005
